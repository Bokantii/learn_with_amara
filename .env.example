# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# developers.facebook.com -> your App -> Facebook Login product -> Settings
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Postgres connection string.
# Local dev: point at a local Postgres (e.g. `createdb iclp_dev`, then
#   postgresql://<your-macos-username>@localhost:5432/iclp_dev?schema=public
# Production: your Neon connection string (neon.tech) — see the "Deployment
# & Environments" section of .claude/plans/on-the-home-page-proud-minsky.md.
DATABASE_URL=

# dashboard.stripe.com -> Developers -> API keys (use the test-mode secret key
# while developing; the "sk_test_..." one, never the live key locally).
STRIPE_SECRET_KEY=

# Local dev: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (Stripe CLI) — it prints a whsec_... signing secret, paste it here.
# Production: dashboard.stripe.com -> Developers -> Webhooks -> add endpoint
# pointing at https://<your-domain>/api/stripe/webhook, then copy its secret.
STRIPE_WEBHOOK_SECRET=

# resend.com -> API Keys -> Create API Key. Free tier works fine to start.
RESEND_API_KEY=

# Must be on a domain you've verified in Resend (resend.com/domains).
# Until you verify one, leave unset — it defaults to Resend's own sandbox
# sender, which only delivers to the email you signed up to Resend with.
EMAIL_FROM="ICLP <onboarding@resend.dev>"

# vercel.com -> your project -> Storage -> create a Blob store -> copy its
# Read/Write token. Needed for assignment-submission file uploads.
BLOB_READ_WRITE_TOKEN=

# console.upstash.com -> create a Redis database -> REST API section.
# Powers rate limiting on login and sign-up. Left unset, rate limiting is
# disabled (all requests allowed) rather than the app failing to start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# sentry.io -> create a project (Next.js) -> Settings -> Client Keys (DSN).
# Left unset, Sentry is a no-op (no events sent, no build failure).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# sentry.io -> Settings -> Auth Tokens. Only needed to upload source maps
# during `npm run build` for readable stack traces in production; safe to
# leave unset locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
