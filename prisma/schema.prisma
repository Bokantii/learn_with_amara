generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js (NextAuth) required models ────────────────────────────────────
// Shape follows https://authjs.dev/getting-started/adapters/prisma exactly,
// so @auth/prisma-adapter works without customization.

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── App models ─────────────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String? // null for OAuth-only accounts (Google/Facebook)
  role          Role      @default(STUDENT)

  accounts         Account[]
  sessions         Session[]
  enrollments      Enrollment[]
  submissions      Submission[]
  payments         Payment[]
  groupMemberships GroupMembership[]
  lessonProgress   LessonProgress[]
  notifications    Notification[]

  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionsCreated")
  attendanceRecords         AttendanceRecord[]  @relation("AttendanceRecordsAsStudent")
  attendanceOverrides       AttendanceRecord[]  @relation("AttendanceRecordsOverriddenBy")

  assessmentAttempts        AssessmentAttempt[]
  assessmentResponsesGraded AssessmentResponse[] @relation("AssessmentResponsesGraded")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Program {
  id     String  @id @default(cuid())
  name   String
  track  String // e.g. "tcf-tef-beginner", "delf-dalf-exam-prep"
  active Boolean @default(true)

  enrollments Enrollment[]
  assignments Assignment[]
  groups      Group[]
  modules     Module[]
  liveClasses LiveClass[]
  assessments Assessment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programs")
}

model Module {
  id          String  @id @default(cuid())
  programId   String  @map("program_id")
  title       String
  description String?
  order       Int
  active      Boolean @default(true)

  program Program  @relation(fields: [programId], references: [id])
  lessons Lesson[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("modules")
}

model Lesson {
  id              String  @id @default(cuid())
  moduleId        String  @map("module_id")
  title           String
  description     String?
  order           Int
  durationMinutes Int?    @map("duration_minutes")
  videoUrl        String? @map("video_url")
  published       Boolean @default(false)

  module    Module           @relation(fields: [moduleId], references: [id])
  resources LessonResource[]
  progress  LessonProgress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lessons")
}

model LessonResource {
  id       String @id @default(cuid())
  lessonId String @map("lesson_id")
  type     String // e.g. "link", "pdf" — matches Assignment.type convention
  title    String
  url      String
  order    Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_resources")
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  lessonId    String               @map("lesson_id")
  status      LessonProgressStatus @default(IN_PROGRESS)
  startedAt   DateTime             @default(now()) @map("started_at")
  completedAt DateTime?            @map("completed_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  programId String           @map("program_id")
  status    EnrollmentStatus @default(ACTIVE)
  progress  Int              @default(0)
  joinedAt  DateTime         @default(now()) @map("joined_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id])

  @@unique([userId, programId])
  @@map("enrollments")
}

model Assignment {
  id        String   @id @default(cuid())
  title     String
  programId String   @map("program_id")
  groupId   String?  @map("group_id")
  dueDate   DateTime @map("due_date")
  points    Int
  type      String
  priority  String

  program     Program      @relation(fields: [programId], references: [id])
  group       Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@map("assignments")
}

model Group {
  id        String @id @default(cuid())
  name      String
  programId String @map("program_id")

  program     Program           @relation(fields: [programId], references: [id])
  members     GroupMembership[]
  assignments Assignment[]
  liveClasses LiveClass[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("groups")
}

model GroupMembership {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  groupId  String   @map("group_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_memberships")
}

enum LiveClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CancellationReason {
  NETWORK_ISSUES
  INSTRUCTOR_UNAVAILABLE
  EMERGENCY
  SCHEDULING_CONFLICT
  OTHER
}

model LiveClass {
  id                  String              @id @default(cuid())
  programId           String              @map("program_id")
  groupId             String?             @map("group_id")
  title               String
  description         String?
  instructorName      String              @map("instructor_name")
  startsAt            DateTime            @map("starts_at")
  endsAt              DateTime            @map("ends_at")
  meetingUrl          String?             @map("meeting_url")
  status              LiveClassStatus     @default(SCHEDULED)
  cancellationReason  CancellationReason? @map("cancellation_reason")
  cancellationMessage String?             @map("cancellation_message")
  rescheduledAt       DateTime?           @map("rescheduled_at")

  program Program @relation(fields: [programId], references: [id])
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("live_classes")
}

enum SubmissionStatus {
  PENDING
  GRADED
}

model Submission {
  id           String           @id @default(cuid())
  studentId    String           @map("student_id")
  assignmentId String           @map("assignment_id")
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  status       SubmissionStatus @default(PENDING)
  score        Int?
  feedback     String?
  fileUrl      String?          @map("file_url")

  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  // Serves the student Results / dashboard read (where studentId = me, status = GRADED).
  @@index([studentId, status])
  @@map("submissions")
}

enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

model Payment {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("usd")
  status          PaymentStatus
  stripePaymentId String?       @unique @map("stripe_payment_id")
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

enum NotificationType {
  CLASS_REMINDER
  CLASS_CANCELLED
  CLASS_RESCHEDULED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id                String              @id @default(cuid())
  recipientUserId   String              @map("recipient_user_id")
  type              NotificationType
  title             String
  message           String
  relatedEntityType String              @map("related_entity_type")
  relatedEntityId   String              @map("related_entity_id")
  channel           NotificationChannel
  status            NotificationStatus
  dedupeKey         String              @map("dedupe_key")
  attempts          Int                 @default(0)
  scheduledFor      DateTime?           @map("scheduled_for")
  sentAt            DateTime?           @map("sent_at")
  readAt            DateTime?           @map("read_at")
  failureReason     String?             @map("failure_reason")

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dedupeKey, channel])
  @@index([recipientUserId, readAt])
  @@index([status, type, channel])
  @@index([relatedEntityType, relatedEntityId])
  @@map("notifications")
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AttendanceSource {
  QR_WEB
  ADMIN_OVERRIDE
}

model AttendanceSession {
  id          String                  @id @default(cuid())
  liveClassId String                  @map("live_class_id")
  createdBy   String                  @map("created_by")
  tokenHash   String                  @unique @map("token_hash")
  status      AttendanceSessionStatus @default(OPEN)
  startsAt    DateTime                @default(now()) @map("starts_at")
  expiresAt   DateTime                @map("expires_at")
  closedAt    DateTime?               @map("closed_at")

  liveClass LiveClass          @relation(fields: [liveClassId], references: [id], onDelete: Restrict)
  creator   User               @relation("AttendanceSessionsCreated", fields: [createdBy], references: [id], onDelete: Restrict)
  records   AttendanceRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([liveClassId, status])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  liveClassId   String           @map("live_class_id")
  sessionId     String?          @map("session_id")
  studentUserId String           @map("student_user_id")
  status        AttendanceStatus
  source        AttendanceSource
  checkedInAt   DateTime?        @map("checked_in_at")
  overriddenBy  String?          @map("overridden_by")
  overrideNote  String?          @map("override_note")

  liveClass LiveClass          @relation(fields: [liveClassId], references: [id], onDelete: Restrict)
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  student   User               @relation("AttendanceRecordsAsStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  overrider User?              @relation("AttendanceRecordsOverriddenBy", fields: [overriddenBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([liveClassId, studentUserId])
  @@index([sessionId])
  // Serves the student attendance-history query (where studentUserId = me);
  // the composite unique above is live_class_id-first and can't.
  @@index([studentUserId])
  @@map("attendance_records")
}

// ─── Assessments / placement test (SPEC §9.2, §10.8, §11.9) ────────────────

enum AssessmentType {
  PLACEMENT
  PRACTICE
  MOCK_EXAM // reserved: model supports it, no dedicated flow yet
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE // exactly one correct option — auto-graded
  SHORT_TEXT // free text, human-graded
  ESSAY // long free text, human-graded
}

enum QuestionSkill {
  GRAMMAR
  VOCABULARY
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum AttemptStatus {
  IN_PROGRESS // resumable
  AWAITING_REVIEW // auto-scored; has ungraded free-text responses
  GRADED // fully scored (auto + any manual)
}

model Assessment {
  id             String           @id @default(cuid())
  type           AssessmentType
  title          String
  description    String?
  status         AssessmentStatus @default(DRAFT)
  language       String           @default("fr") // ISO code of the question content
  programId      String?          @map("program_id") // PRACTICE is program-scoped; PLACEMENT/MOCK are not
  questionCount  Int?             @map("question_count") // questions drawn per attempt; null = all active
  passPercentage Int?             @map("pass_percentage") // PRACTICE % display only

  program   Program?            @relation(fields: [programId], references: [id])
  questions Question[]
  attempts  AssessmentAttempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, status])
  @@map("assessments")
}

model Question {
  id           String        @id @default(cuid())
  assessmentId String        @map("assessment_id")
  type         QuestionType
  skill        QuestionSkill
  cefrLevel    CefrLevel?    @map("cefr_level") // drives the placement ladder
  order        Int
  active       Boolean       @default(true)
  prompt       String
  explanation  String? // shown only on the post-submit review, never during an attempt
  maxPoints    Int?          @map("max_points") // free-text grading cap

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    QuestionOption[]
  responses  AssessmentResponse[]
  attemptRefs AssessmentAttemptQuestion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([assessmentId, active])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  order      Int
  text       String
  isCorrect  Boolean @default(false) @map("is_correct") // never serialized to a student mid-attempt

  question  Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[] @relation("ResponseSelectedOption")

  @@map("question_options")
}

model AssessmentAttempt {
  id           String        @id @default(cuid())
  assessmentId String        @map("assessment_id")
  // Set for a signed-in student's attempt. Null for an anonymous public
  // placement attempt, which is owned via `claimTokenHash` (an httpOnly cookie
  // holds the raw token) — no fake User/Enrollment row is ever created.
  userId         String? @map("user_id")
  claimTokenHash String? @unique @map("claim_token_hash")
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now()) @map("started_at")
  submittedAt  DateTime?     @map("submitted_at")
  gradedAt     DateTime?     @map("graded_at")

  // Derived result — stored separately from the source responses.
  autoScorePoints   Int?       @map("auto_score_points")
  autoMaxPoints     Int?       @map("auto_max_points")
  manualScorePoints Int?       @map("manual_score_points")
  manualMaxPoints   Int?       @map("manual_max_points")
  estimatedCefr     CefrLevel? @map("estimated_cefr") // PLACEMENT only
  recommendedTrack  String?    @map("recommended_track") // PLACEMENT only; a Program.track slug
  resultSummary     String?    @map("result_summary")

  assessment Assessment                  @relation(fields: [assessmentId], references: [id])
  user       User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions  AssessmentAttemptQuestion[]
  responses  AssessmentResponse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([assessmentId, status])
  @@map("assessment_attempts")
}

model AssessmentAttemptQuestion {
  id         String @id @default(cuid())
  attemptId  String @map("attempt_id")
  questionId String @map("question_id")
  order      Int

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("assessment_attempt_questions")
}

model AssessmentResponse {
  id               String  @id @default(cuid())
  attemptId        String  @map("attempt_id")
  questionId       String  @map("question_id")
  selectedOptionId String? @map("selected_option_id") // SINGLE_CHOICE
  textResponse     String? @map("text_response") // free text, length-capped in the action
  isCorrect        Boolean? @map("is_correct") // auto-graded questions only
  awardedPoints    Int?     @map("awarded_points")
  graderFeedback   String?  @map("grader_feedback")
  gradedById       String?  @map("graded_by_id")

  answeredAt DateTime @default(now()) @map("answered_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question          @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption?   @relation("ResponseSelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
  gradedBy       User?             @relation("AssessmentResponsesGraded", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("assessment_responses")
}
